# ============================================================================
# Localiiiy — Public GitHub Repository Security & Build Hygiene (.gitignore)
# ============================================================================

# 1. Secret Keys, Environment Variables & Cloud Credentials (NEVER COMMIT)
.env
.env.*
!.env.example
local.properties
app/google-services.json
google-services.json
!app/google-services.example.json
**/firebase_applet_config.xml
service-account*.json
firebase-debug.log
firestore-debug.log

# 2. Android Signing Keystores & Certificates (NEVER COMMIT)
*.jks
*.keystore
debug.keystore
debug.keystore.base64
*.pem
*.p12
*.pk8
*.x509.pem
*.key

# 3. Compiled Android Binaries & Decompiler Tools (Prevents >100MB GitHub Push Failures & APK Decompilation)
*.apk
*.aab
!Localiiiy-v3.0.0-build30-DEX-OPTIMIZED.aab
!/public/Localiiiy-v3.0.0-build30-DEX-OPTIMIZED.aab
*.apks
*.dex
*.class
*.so
cfr.jar
/downloads/
/download/
/release/
/public/downloads/
/tmp/

# 4. Gradle, Kotlin & Android Studio Build Directories
*.iml
.gradle/
.kotlin/
.idea/
.DS_Store
/build/
/app/build/
.build-outputs/
/captures/
.externalNativeBuild/
.cxx/

# 5. Personal Chat Attachments / Screenshots
/public/assets/aistudio/
/assets/aistudio/
