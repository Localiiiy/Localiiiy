rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isValidString(text, maxLen) {
      return text is string && text.size() > 0 && text.size() <= maxLen;
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId)
        && isValidString(request.resource.data.displayName, 50)
        && (!request.resource.data.keys().hasAny(['isAdmin', 'isVerifiedBadge', 'walletBalance']));
      allow delete: if isOwner(userId);
    }

    // 2. Hyperlocal Pulses & Short Video Clips
    match /hyperlocal_updates/{pulseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid
        && isValidString(request.resource.data.content, 2000)
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
      allow update: if isAuthenticated()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    // 3. Private Messaging (Strict Participant Gating)
    match /direct_messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.senderId == request.auth.uid &&
        isValidString(request.resource.data.text, 3000)
      );
      allow update, delete: if false; // Messages are immutable
    }

    // 4. Marketplace Listings
    match /market_items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && isValidString(request.resource.data.title, 100);
      allow update: if isAuthenticated() 
        && resource.data.sellerUid == request.auth.uid
        && request.resource.data.sellerUid == resource.data.sellerUid
        && request.resource.data.price > 0;
      allow delete: if isAuthenticated() && resource.data.sellerUid == request.auth.uid;
    }

    // New: Username Reservation (Atomic)
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false; 
    }

    // 5. Escrow Transactions
    match /escrow_transactions/{txId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerUid == request.auth.uid || 
        resource.data.sellerUid == request.auth.uid
      );
      allow write: if false; // Mutated only by trusted server
    }

    // 6. Creator & Community Wallets (Read-only for owner, server-authoritative mutations only)
    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Tamper-proof: client cannot alter balances
    }

    // 7. Payout Withdrawal Requests (Idempotent creation, immutable once created)
    match /payout_requests/{requestId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount >= 1000.0 // Enforces minimum payout threshold ($1000)
        && request.resource.data.status == 'PENDING'
        && isValidString(request.resource.data.idempotencyKey, 100);
      allow update, delete: if false; // Server-only status transitions
    }

    // 8. Audit Ledger & Transaction Receipts (Immutable write-once log)
    match /wallet_ledger/{ledgerId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Only server writes ledger entries
    }

    // 9. Media Fingerprints Catalog (Read-accessible for anti-theft lookups; creation authenticated)
    match /content_fingerprints/{fingerprintId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && isValidString(request.resource.data.sha256, 64)
        && isValidString(request.resource.data.pHash, 32);
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // 10. Copyright Claims (1-tap filing, rights-holder protection)
    match /copyright_claims/{claimId} {
      allow read: if isAuthenticated() && (
        resource.data.claimantUid == request.auth.uid ||
        resource.data.uploaderUid == request.auth.uid
      );
      allow create: if isAuthenticated()
        && request.resource.data.claimantUid == request.auth.uid
        && isValidString(request.resource.data.targetContentId, 100)
        && request.resource.data.status == 'PENDING_JUSTIFICATION';
      allow update: if isAuthenticated() && (
        // Claimant can accept/drop or confirm strike
        resource.data.claimantUid == request.auth.uid ||
        // Uploader can update counter-notification within 7 days
        (resource.data.uploaderUid == request.auth.uid && request.time < resource.data.counterNotificationDeadline)
      );
      allow delete: if false; // Audit retention
    }

    // 11. Counter-Justifications (7-day statutory window)
    match /counter_justifications/{justificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.uploaderUid == request.auth.uid
        && isValidString(request.resource.data.writtenStatement, 3000)
        && request.resource.data.perjuryAffirmation == true;
      allow update, delete: if false;
    }

    // 12. Copyright Strikes & Revenue Reroutes (Server-authoritative mutations only)
    match /copyright_strikes/{strikeId} {
      allow read: if isAuthenticated() && (
        resource.data.offenderUid == request.auth.uid ||
        resource.data.claimantUid == request.auth.uid
      );
      allow write: if false; // Server-only strike issuance
    }

    match /revenue_reroutes/{rerouteId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUploaderUid == request.auth.uid ||
        resource.data.toCreatorUid == request.auth.uid
      );
      allow write: if false; // Tamper-proof 100% rerouting ledger
    }
  }
}
